{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/skill-transfer-debugging/task.schema.json",
  "title": "DebuggingTask",
  "description": "A reproducible test-failure debugging task used for low-shot procedural skill transfer evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "bug_family",
    "split",
    "repo",
    "environment",
    "failure",
    "labels"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Stable unique task identifier."
    },
    "bug_family": {
      "type": "string",
      "description": "Bug-family label used for low-shot within-family transfer."
    },
    "split": {
      "type": "string",
      "enum": ["train", "heldout", "adversarial"],
      "description": "Experimental split."
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "commit", "language"],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["bugsinpy", "pybughive", "swebench_lite", "swegym", "defects4j", "synthetic", "local"]
        },
        "url": {
          "type": ["string", "null"]
        },
        "commit": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_command", "test_command", "timeout_seconds"],
      "properties": {
        "python_version": {
          "type": ["string", "null"]
        },
        "install_command": {
          "type": "string"
        },
        "test_command": {
          "type": "string",
          "description": "Command used to reproduce the target failing test."
        },
        "full_test_command": {
          "type": ["string", "null"],
          "description": "Optional broader regression test command."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failing_tests", "error_type", "failure_log_path"],
      "properties": {
        "failing_tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "error_type": {
          "type": "string"
        },
        "error_message": {
          "type": ["string", "null"]
        },
        "failure_log_path": {
          "type": "string"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patch_path": {
          "type": ["string", "null"]
        },
        "modified_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bug_summary": {
          "type": ["string", "null"]
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["pybughive", "bugsinpy", "swebench_lite", "swegym", "defects4j", "synthetic", "local"]
        },
        "project": {
          "type": ["string", "null"]
        },
        "issue_id": {
          "type": ["string", "integer", "null"]
        },
        "buggy_commit": {
          "type": ["string", "null"]
        },
        "fix_commit": {
          "type": ["string", "null"]
        },
        "test_patch_path": {
          "type": ["string", "null"]
        },
        "metadata_path": {
          "type": ["string", "null"]
        },
        "original_install_steps": {
          "type": ["string", "null"]
        },
        "original_test_steps": {
          "type": ["string", "null"]
        },
        "original_full_test_steps": {
          "type": ["string", "null"]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_pattern", "root_cause"],
      "properties": {
        "surface_pattern": {
          "type": "string"
        },
        "root_cause": {
          "type": "string"
        },
        "requires_api_knowledge": {
          "type": "boolean"
        },
        "adversarial_reason": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "examples": [
    {
      "task_id": "pybh_001",
      "bug_family": "test_failure_triage",
      "split": "heldout",
      "repo": {
        "name": "sample_project",
        "source": "pybughive",
        "url": "https://github.com/example/sample_project",
        "commit": "abc123",
        "language": "python"
      },
      "environment": {
        "python_version": "3.11",
        "install_command": "pip install -e . pytest",
        "test_command": "pytest tests/test_parser.py::test_empty_input -q",
        "full_test_command": "pytest -q",
        "timeout_seconds": 120
      },
      "failure": {
        "failing_tests": ["tests/test_parser.py::test_empty_input"],
        "error_type": "AssertionError",
        "error_message": "Expected [], got None",
        "failure_log_path": "logs/initial_failure.txt"
      },
      "ground_truth": {
        "patch_path": "patches/reference.patch",
        "modified_files": ["src/parser.py"],
        "bug_summary": "Empty input returns None instead of empty list."
      },
      "labels": {
        "surface_pattern": "assertion_mismatch",
        "root_cause": "missing_edge_case_handling",
        "requires_api_knowledge": false,
        "adversarial_reason": null
      }
    }
  ]
}
